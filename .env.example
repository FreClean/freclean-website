# Public runtime configuration for the static website.
# Purpose: canonical site base used for generated links and redirects.
# Required: optional for local development, required in production for canonical links.
# Client/server: public, browser-readable.
# Environment: local, staging, production.
# Validation: must be an HTTPS URL without credentials.
FRECLEAN_SITE_BASE_URL=https://freclean.com

# Purpose: public request endpoint for non-sensitive service enquiries.
# Required: optional while the public request contract is being finalized.
# Client/server: public, browser-readable when configured.
# Environment: staging, production.
# Validation: must be HTTPS and must not target the protected Core booking API.
FRECLEAN_PUBLIC_REQUEST_URL=

# Purpose: external CeloHT payment route for eligible crypto payments.
# Required: optional until the business flow is approved.
# Client/server: public, browser-readable.
# Environment: staging, production.
# Validation: must use the canonical app.celoht.com URL or a verified approved alternate.
FRECLEAN_CELOHT_DAPP_URL=https://app.celoht.com

# Purpose: shared support email used in contact and fallback flows.
# Required: recommended for production support operations.
# Client/server: public, browser-readable.
# Environment: all.
# Validation: must be a valid email address and must not expose service-role credentials.
FRECLEAN_SUPPORT_EMAIL=freclean7@gmail.com

# Production API configuration is intentionally separate from public browser variables.
# Purpose: server-side integration base for official public API access.
# Required: required only when the backend is enabled for public API consumption.
# Client/server: server-only.
# Environment: staging, production.
# Validation: must be an HTTPS origin, must not include secrets, and must not be a private internal URL.
FRECLEAN_PUBLIC_API_BASE_URL=

# Purpose: request timeout used by approved public API clients.
# Required: optional for local development, recommended in production.
# Client/server: server-only.
# Environment: staging, production.
# Validation: must be a positive integer in milliseconds.
FRECLEAN_PUBLIC_API_TIMEOUT_MS=15000
